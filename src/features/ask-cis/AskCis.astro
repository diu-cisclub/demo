---
/**
 * Feature B: "Ask CIS". Common questions are answered instantly on the
 * visitor's device from ready-made answers (src/lib/answers.ts); anything else
 * goes to a small cloud function (supabase/functions/ask) that answers with
 * Google Gemini from the site's own pages. Only the launcher ships with the
 * page; the rest loads when it is opened.
 */
const suggestions = ['How much is membership?', 'What’s the next event?', 'Who is the president?'];
---

<div class="ask" data-ask>
  <button class="launcher" type="button" aria-expanded="false" aria-controls="ask-panel" data-ask-open>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="7" r="2"></circle><circle cx="5" cy="17" r="2"></circle><circle cx="19" cy="12" r="2.5"></circle><path d="M7 7.5 16.6 11.4M7 16.5l9.6-3.9"></path></svg>
    Ask CIS
  </button>

  <section id="ask-panel" class="panel" role="dialog" aria-labelledby="ask-title" hidden data-ask-panel>
    <header class="head">
      <h2 id="ask-title">Ask CIS</h2>
      <button class="close" type="button" aria-label="Close Ask CIS" data-ask-close>×</button>
    </header>

    <div class="log" aria-live="polite" data-ask-log>
      <div class="msg msg--bot"><p>Hi! Ask about joining, the fee, events, the committee or learning resources.</p></div>
      <div class="suggest">
        {suggestions.map((s) => <button type="button" data-ask-suggest>{s}</button>)}
      </div>
    </div>

    <form class="ask-form" data-ask-form>
      <label class="visually-hidden" for="ask-input">Your question</label>
      <input id="ask-input" name="q" autocomplete="off" maxlength="300" placeholder="Type a question…" required />
      <button class="button" type="submit">Ask</button>
    </form>
    <p class="fine">Common questions are answered instantly from this site. Others are sent to Google Gemini, so don’t include personal details.</p>
  </section>
</div>

<script>
  // Load the panel code only on first open.
  const root = document.querySelector<HTMLElement>('[data-ask]');
  const open = root?.querySelector<HTMLButtonElement>('[data-ask-open]');
  let mounted: Promise<{ toggle: (show?: boolean) => void }> | null = null;
  open?.addEventListener('click', async () => {
    mounted ??= import('./panel').then((m) => m.mountAskCis(root!));
    (await mounted).toggle();
  });
</script>

<style>
  .launcher {
    position: fixed;
    right: max(var(--space-4), env(safe-area-inset-right));
    bottom: max(var(--space-4), env(safe-area-inset-bottom));
    z-index: var(--z-overlay);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.7rem 1.1rem 0.7rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--on-ink);
    font-weight: 600;
    box-shadow: 0 6px 24px rgb(49 48 54 / 0.22);
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .launcher:hover {
    transform: translateY(-1px);
  }
  .launcher[aria-expanded='true'] {
    opacity: 0;
    pointer-events: none;
  }
  .launcher svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .launcher circle:last-of-type {
    fill: var(--signal);
    stroke: var(--signal);
  }
  .panel {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: var(--z-dialog);
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: var(--space-3);
    width: min(25rem, calc(100vw - 2rem));
    height: min(34rem, calc(100dvh - 2rem));
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    box-shadow:
      0 0 0 1px var(--rule),
      0 18px 48px rgb(49 48 54 / 0.22);
  }
  .head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .head h2 {
    font-size: var(--text-lg);
  }
  .close {
    margin-left: auto;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    font-size: 1.4rem;
    cursor: pointer;
  }
  .close:hover {
    background: var(--paper-sunk);
  }
  .log {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .log :global(.msg) {
    display: grid;
    gap: var(--space-2);
    max-width: 92%;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .log :global(.msg p) {
    white-space: pre-wrap;
  }
  .log :global(.msg--bot) {
    background: var(--paper);
  }
  .log :global(.msg--you) {
    justify-self: end;
    background: var(--ink);
    color: var(--on-ink);
  }
  .log :global(.is-thinking) {
    color: var(--ink-soft);
  }
  .log :global(.msg-links) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .log :global(.msg-links a) {
    font-weight: 600;
  }
  .log :global(.msg-note) {
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }
  .suggest {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .suggest button {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .suggest button:hover {
    border-color: var(--ink);
  }
  .ask-form {
    display: flex;
    gap: var(--space-2);
  }
  .ask-form input {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--paper);
    font-size: 1rem;
  }
  .ask-form .button {
    min-height: 2.75rem;
  }
  .fine {
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }
  @media (max-width: 30rem) {
    .panel {
      right: 0;
      bottom: 0;
      width: 100vw;
      height: 85dvh;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }
  }
</style>
