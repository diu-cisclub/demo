---
/**
 * Feature B: "Ask CIS", an assistant that runs on the visitor's device.
 * Only this launcher button ships with the page; all model code is imported
 * when the panel is first opened, and models download only after consent.
 */
---

<div class="ask" data-ask>
  <button class="launcher" type="button" aria-expanded="false" aria-controls="ask-panel" data-ask-open>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="7" r="2"></circle><circle cx="5" cy="17" r="2"></circle><circle cx="19" cy="12" r="2.5"></circle><path d="M7 7.5 16.6 11.4M7 16.5l9.6-3.9"></path></svg>
    Ask CIS
  </button>

  <section id="ask-panel" class="panel" role="dialog" aria-labelledby="ask-title" hidden data-ask-panel>
    <header class="head">
      <h2 id="ask-title">Ask CIS</h2>
      <span class="badge">Runs on your device. No servers.</span>
      <button class="close" type="button" aria-label="Close Ask CIS" data-ask-close>×</button>
    </header>

    <div class="log" aria-live="polite" data-ask-log>
      <p class="msg msg--bot">Ask about events, joining, the committee or learning resources. I search this website and answer from it.</p>
    </div>

    <div class="start" data-ask-start>
      <button class="button" type="button" data-ask-load>Start quick answers</button>
      <p class="fine">One-time 23 MB download of an open model from Hugging Face, then cached. Your questions never leave this device.</p>
    </div>

    <div class="progress" hidden data-ask-progress>
      <div class="bar"><span data-ask-bar></span></div>
      <p class="fine" data-ask-progress-text>Downloading…</p>
    </div>

    <form class="ask-form" hidden data-ask-form>
      <label class="visually-hidden" for="ask-input">Your question</label>
      <input id="ask-input" name="q" autocomplete="off" maxlength="300" placeholder="e.g. When is the next AI contest?" required />
      <button class="button" type="submit">Ask</button>
    </form>
    <p class="fine wake" hidden data-ask-wake-row>
      <button type="button" class="link" data-ask-wake>Wake the AI for written answers</button>
      <span data-ask-wake-note>(about 300 MB, needs a recent browser with WebGPU)</span>
    </p>
  </section>
</div>

<script>
  // Load the panel code only on first open.
  const root = document.querySelector<HTMLElement>('[data-ask]');
  const open = root?.querySelector<HTMLButtonElement>('[data-ask-open]');
  let mounted: Promise<{ toggle: (show?: boolean) => void }> | null = null;
  open?.addEventListener('click', async () => {
    mounted ??= import('./panel').then((m) => m.mountAskCis(root!));
    (await mounted).toggle();
  });
</script>

<style>
  .launcher {
    position: fixed;
    right: max(var(--space-4), env(safe-area-inset-right));
    bottom: max(var(--space-4), env(safe-area-inset-bottom));
    z-index: var(--z-overlay);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.7rem 1.1rem 0.7rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--on-ink);
    font-weight: 600;
    box-shadow: 0 6px 24px rgb(49 48 54 / 0.22);
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .launcher:hover {
    transform: translateY(-1px);
  }
  .launcher[aria-expanded='true'] {
    opacity: 0;
    pointer-events: none;
  }
  .launcher svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .launcher circle:last-of-type {
    fill: var(--signal);
    stroke: var(--signal);
  }
  .panel {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: var(--z-dialog);
    display: grid;
    grid-template-rows: auto 1fr auto auto auto auto;
    gap: var(--space-3);
    width: min(25rem, calc(100vw - 2rem));
    max-height: min(38rem, calc(100dvh - 2rem));
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    box-shadow:
      0 0 0 1px var(--rule),
      0 18px 48px rgb(49 48 54 / 0.22);
  }
  .panel[hidden] {
    display: none;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .head h2 {
    font-size: var(--text-lg);
  }
  .badge {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--success);
  }
  .close {
    margin-left: auto;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    font-size: 1.4rem;
    cursor: pointer;
  }
  .close:hover {
    background: var(--paper-sunk);
  }
  .log {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    overflow-y: auto;
    min-height: 6rem;
    overscroll-behavior: contain;
  }
  .log :global(.msg) {
    max-width: 92%;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: 1.5;
    white-space: pre-wrap;
  }
  .log :global(.msg--bot) {
    background: var(--paper);
  }
  .log :global(.msg--you) {
    justify-self: end;
    background: var(--ink);
    color: var(--on-ink);
  }
  .log :global(.hits) {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
  }
  .log :global(.hits a) {
    font-weight: 600;
  }
  .log :global(.hits p) {
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  .fine {
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }
  .start {
    display: grid;
    gap: var(--space-2);
  }
  .bar {
    height: 6px;
    border-radius: 3px;
    background: var(--paper-sunk);
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--signal);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform var(--dur) var(--ease-out);
  }
  .ask-form {
    display: flex;
    gap: var(--space-2);
  }
  .ask-form input {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--paper);
    font-size: 1rem;
  }
  .ask-form .button {
    min-height: 2.75rem;
  }
  .link {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    cursor: pointer;
  }
  @media (max-width: 30rem) {
    .panel {
      right: 0;
      bottom: 0;
      width: 100vw;
      max-height: 85dvh;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }
  }
</style>
