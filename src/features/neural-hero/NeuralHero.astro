---
/**
 * Feature A: the live neural network. Visitors draw a digit and watch a
 * 64→16→12→10 network read it, entirely in the browser.
 * Remove the feature by deleting this folder and its one usage in pages/index.astro.
 */
import weights from './weights.json';

interface Props {
  caption: string;
}
const { caption } = Astro.props;
const neurons = weights.layers.reduce((n, l) => n + l.b.length, 0) + weights.inputSize ** 2;
---

<figure class="hero-net chamfer" data-neural-hero>
  <div class="stage">
    <div class="pad-wrap">
      <canvas class="pad" data-pad aria-label="Drawing pad. Draw a digit with a mouse, pen or finger." role="img"></canvas>
      <button class="clear" type="button" data-clear>Clear</button>
    </div>
    <div class="net-wrap">
      <canvas class="net" data-net role="img" aria-label="Diagram of the network: input grid, two hidden layers and ten outputs."></canvas>
    </div>
  </div>

  <figcaption>
    <div class="caption-head">
      <div>
        <p class="status" role="status" aria-live="polite" data-status>Waiting for a digit</p>
        <p>{caption}</p>
      </div>
      <p class="readout" aria-hidden="true">
        <span class="readout-digit tabular" data-readout>–</span>
        <span class="readout-label">best guess</span>
      </p>
    </div>
    <div class="samples" role="group" aria-label="Load a sample digit">
      <span class="muted">Or try</span>
      {Array.from({ length: 10 }, (_, d) => <button type="button" data-sample={d} aria-label={`Sample ${d}`}>{d}</button>)}
    </div>
    <p class="meta tabular">{neurons} neurons, {(weights.accuracy * 100).toFixed(1)}% accurate on test digits. Nothing you draw leaves this page.</p>
  </figcaption>
</figure>

<script>
  import { mountNeuralHero } from './hero';
  document.querySelectorAll<HTMLElement>('[data-neural-hero]').forEach(mountNeuralHero);
</script>

<style>
  .hero-net {
    --cut: var(--cut-lg);
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--paper-raised);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .stage {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-5);
    align-items: center;
  }
  .pad-wrap {
    position: relative;
  }
  /* Graph paper: the lab notebook the network lives in. */
  .pad {
    width: 100%;
    aspect-ratio: 1;
    touch-action: none;
    cursor: crosshair;
    border-radius: var(--radius-md);
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 12.5% 12.5%;
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .clear {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--paper-raised);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }
  [data-has-ink] .clear,
  .clear:focus-visible {
    opacity: 1;
  }
  .net {
    width: 100%;
    aspect-ratio: 1.1;
  }
  .caption-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-5);
  }
  .readout {
    flex: none;
    display: grid;
    justify-items: end;
    line-height: 1;
  }
  .readout-digit {
    font-size: 3.25rem;
    font-weight: 800;
    font-stretch: 85%;
    color: var(--signal);
  }
  .readout-label {
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }
  figcaption {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }
  .status {
    font-weight: 600;
    color: var(--ink);
  }
  .samples {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
  }
  .samples .muted {
    margin-right: var(--space-1);
  }
  .samples button {
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: transparent;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .samples button:hover {
    border-color: var(--ink);
  }
  .meta {
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }
  @media (max-width: 34rem) {
    .hero-net {
      padding: var(--space-4);
    }
    .stage {
      grid-template-columns: 1fr;
    }
    .pad {
      max-width: 18rem;
      margin-inline: auto;
    }
  }
</style>
