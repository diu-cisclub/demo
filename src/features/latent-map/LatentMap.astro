---
/**
 * Feature C: the event "latent space" map. Every event is a point; events
 * whose write-ups use similar words sit close together. Positions are
 * computed at build time (lsa.ts), so the map is plain SVG with zero JS.
 */
import type { EventEntry } from '../../lib/content';
import { eventUrl } from '../../lib/content';
import { categoryVar } from '../../lib/categories';
import { formatEventDate } from '../../lib/dates';
import { withBase } from '../../lib/url';
import { EVENT_CATEGORIES } from '../../content.config';
import { latentPositions } from './lsa';

interface Props {
  events: EventEntry[];
}
const { events } = Astro.props;

const W = 1000;
const H = 620;
const PAD = 48;
const text = (e: EventEntry) => [e.data.title, e.data.title, e.data.category, e.data.category, e.data.summary, e.body ?? ''].join(' ');
const pos = latentPositions(events.map(text)).map((p) => ({ x: PAD + p.x * (W - PAD * 2), y: PAD + p.y * (H - PAD * 2) }));

// Nudge overlapping points apart so every one stays clickable.
const radius = events.map((e) => 7 + Math.sqrt(e.data.photos.length) * 2.4 + (e.data.featured ? 3 : 0));
for (let it = 0; it < 60; it++) {
  for (let i = 0; i < pos.length; i++) {
    for (let j = i + 1; j < pos.length; j++) {
      const a = pos[i]!;
      const b = pos[j]!;
      const min = radius[i]! + radius[j]! + 4;
      const dx = b.x - a.x || 0.01;
      const dy = b.y - a.y;
      const d = Math.hypot(dx, dy);
      if (d < min) {
        const push = (min - d) / 2;
        a.x -= (dx / d) * push;
        a.y -= (dy / d) * push;
        b.x += (dx / d) * push;
        b.y += (dy / d) * push;
      }
    }
  }
}
const clampX = (x: number) => Math.min(W - PAD / 2, Math.max(PAD / 2, x));
const clampY = (y: number) => Math.min(H - PAD / 2, Math.max(PAD / 2, y));
---

<figure class="map">
  <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Map of events, positioned by similarity of their descriptions">
    {
      events.map((e, i) => {
        const x = clampX(pos[i]!.x);
        const y = clampY(pos[i]!.y);
        const anchor = x > W * 0.7 ? 'end' : 'start';
        return (
          <a href={withBase(eventUrl(e))} class:list={['pt', `pt--${categoryVar(e.data.category)}`]}>
            <title>{`${e.data.title} (${formatEventDate(e.data)})`}</title>
            <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r={radius[i]!.toFixed(1)} />
            <text x={(x + (anchor === 'end' ? -1 : 1) * (radius[i]! + 8)).toFixed(1)} y={(y + 5).toFixed(1)} text-anchor={anchor}>
              {e.data.title}
            </text>
          </a>
        );
      })
    }
  </svg>
  <figcaption>
    <ul class="legend">
      {EVENT_CATEGORIES.map((c) => <li class:list={['key', `pt--${categoryVar(c)}`]}>{c}</li>)}
    </ul>
    <p class="muted">
      Each point is an event, placed by latent semantic analysis of its write-up: events described with similar words sit
      close together. Bigger points have more photos. Hover or focus a point to see its name.
    </p>
  </figcaption>
</figure>

<style>
  .map {
    display: grid;
    gap: var(--space-4);
  }
  svg {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    background-color: var(--paper-raised);
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 5% 8%;
    box-shadow: inset 0 0 0 1px var(--rule);
    overflow: visible;
  }
  .pt circle {
    fill: var(--c);
    fill-opacity: 0.78;
    stroke: var(--paper-raised);
    stroke-width: 2;
    transition: fill-opacity var(--dur-fast) var(--ease-out);
  }
  .pt text {
    font-size: 17px;
    font-weight: 600;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--paper-raised);
    stroke-width: 5px;
    stroke-linejoin: round;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .pt:hover circle,
  .pt:focus-visible circle {
    fill-opacity: 1;
    stroke: var(--ink);
  }
  .pt:hover text,
  .pt:focus-visible text {
    opacity: 1;
  }
  .pt:focus-visible {
    outline: none;
  }
  /* Bring the hovered point and its label above its neighbours. */
  svg:has(.pt:hover) .pt:not(:hover) circle {
    fill-opacity: 0.35;
  }

  .pt--ai { --c: var(--cat-ai); }
  .pt--workshop { --c: var(--cat-workshop); }
  .pt--win { --c: var(--cat-win); }
  .pt--partner { --c: var(--cat-partner); }
  .pt--sports { --c: var(--cat-sports); }
  .pt--culture { --c: var(--cat-culture); }
  .pt--community { --c: var(--cat-community); }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .key::before {
    content: '';
    width: 0.75em;
    height: 0.75em;
    border-radius: 50%;
    background: var(--c);
  }
  figcaption .muted {
    font-size: var(--text-sm);
    max-width: 70ch;
  }
</style>
