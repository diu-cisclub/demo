---
/**
 * Thumbnails that open in the <Lightbox />. Each thumbnail links to the full
 * image, so without JavaScript a click simply opens the photo.
 * Put <Lightbox /> once on any page that uses this.
 */
import { Image, getImage } from 'astro:assets';

interface Props {
  photos: ImageMetadata[];
  /** Used for alt text and the lightbox caption. */
  title: string;
  /** Groups photos so the lightbox steps through one event at a time. */
  group: string;
  limit?: number;
  /** Photos already shown elsewhere on the page (e.g. a cover), for "photo 2 of 5" numbering. */
  offset?: number;
}
const { photos, title, group, limit, offset = 0 } = Astro.props;
const total = photos.length + offset;
const shown = limit ? photos.slice(0, limit) : photos;
const full = await Promise.all(shown.map((p) => getImage({ src: p, format: 'webp', quality: 82 })));
---

<ul class="photos">
  {
    shown.map((photo, i) => (
      <li>
        <a href={full[i]!.src} data-lightbox={group} data-caption={`${title}, photo ${i + 1 + offset} of ${total}`}>
          <Image src={photo} alt={`${title}, photo ${i + 1 + offset}`} widths={[240, 360, 480]} sizes="(max-width: 40rem) 50vw, 240px" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(11rem, 45%), 1fr));
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }
  a {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-sm);
    aspect-ratio: 1;
    background: var(--paper-sunk);
  }
  a :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-spring);
  }
  a:hover :global(img) {
    transform: scale(1.04);
  }
</style>
