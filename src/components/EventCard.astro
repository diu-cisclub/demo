---
/**
 * An event as a card: photo first, then date and title.
 * `size="large"` is used for the lead item in a grid.
 */
import { Image } from 'astro:assets';
import type { EventEntry } from '../lib/content';
import { eventUrl } from '../lib/content';
import { formatEventDate, isoDate } from '../lib/dates';
import { withBase } from '../lib/url';
import CategoryTag from './CategoryTag.astro';

interface Props {
  event: EventEntry;
  size?: 'large' | 'default';
  headingLevel?: 'h2' | 'h3';
  /** The first card on a page loads eagerly (it is likely the LCP image). */
  eager?: boolean;
}
const { event, size = 'default', headingLevel: Heading = 'h3', eager = false } = Astro.props;
const { data } = event;
const cover = data.photos[0];
---

<article class:list={['card', `card--${size}`]}>
  <div class="media">
    {
      cover ? (
        <Image
          src={cover}
          alt=""
          widths={size === 'large' ? [480, 720, 960] : [360, 540]}
          sizes={size === 'large' ? '(max-width: 48rem) 100vw, 60vw' : '(max-width: 48rem) 100vw, 30vw'}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
        />
      ) : (
        <div class="placeholder" aria-hidden="true">
          <span>{data.titleBn ?? data.title}</span>
        </div>
      )
    }
  </div>
  <div class="body">
    <p class="meta">
      <time datetime={isoDate(data.date)}>{formatEventDate(data)}</time>
      <CategoryTag category={data.category} />
    </p>
    <Heading class="title">
      <a href={withBase(eventUrl(event))}>{data.title}</a>
    </Heading>
    {size === 'large' && <p class="summary">{data.summary}</p>}
    {data.result && <p class="result">{data.result}</p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .media {
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--paper-sunk);
    aspect-ratio: 4 / 3;
  }
  .card--large .media {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-spring);
  }
  .card:hover .media :global(img) {
    transform: scale(1.03);
  }
  .placeholder {
    display: grid;
    place-items: end start;
    height: 100%;
    padding: var(--space-4);
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 1.5rem 1.5rem;
  }
  .placeholder span {
    font-size: var(--text-xl);
    font-weight: 750;
    font-stretch: 85%;
    line-height: 1.1;
    color: var(--ink-soft);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }
  .title {
    font-size: var(--text-lg);
  }
  .card--large .title {
    font-size: var(--text-2xl);
  }
  /* The whole card is clickable through the title link. */
  .title a {
    text-decoration: none;
  }
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }
  .card:has(a:focus-visible) {
    outline: 2px solid var(--signal);
    outline-offset: 6px;
    border-radius: var(--radius-md);
  }
  .title a:focus-visible {
    outline: none;
  }
  .summary {
    color: var(--ink-soft);
    max-width: 52ch;
  }
  .result {
    font-weight: 600;
    color: var(--signal-strong);
  }
</style>
