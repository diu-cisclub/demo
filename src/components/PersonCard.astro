---
/**
 * A person: portrait if one was uploaded through the CMS, otherwise
 * a clean initials avatar (the Facebook birthday cards are not portraits).
 */
import { Image } from 'astro:assets';
import { initials } from '../lib/content';

interface Props {
  name: string;
  role: string;
  photo?: ImageMetadata | undefined;
  size?: 'default' | 'small';
}
const { name, role, photo, size = 'default' } = Astro.props;
---

<li class:list={['person', `person--${size}`]}>
  {
    photo ? (
      <Image class="avatar" src={photo} alt="" width={160} height={160} />
    ) : (
      <span class="avatar initials" aria-hidden="true">
        {initials(name)}
      </span>
    )
  }
  <span class="text">
    <span class="name">{name}</span>
    <span class="role">{role}</span>
  </span>
</li>

<style>
  .person {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }
  .avatar {
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .person--small .avatar {
    width: 2.5rem;
    height: 2.5rem;
  }
  .initials {
    display: grid;
    place-items: center;
    background: var(--paper-sunk);
    color: var(--ink);
    font-weight: 700;
    font-stretch: 85%;
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .text {
    display: grid;
    min-width: 0;
  }
  .name {
    font-weight: 600;
    line-height: 1.3;
  }
  .role {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    line-height: 1.35;
  }
</style>
