---
import BaseLayout from '../layouts/BaseLayout.astro';
import NeuralHero from '../features/neural-hero/NeuralHero.astro';
import PersonCard from '../components/PersonCard.astro';
import { getCommittees, getEventTimeline, getSettings, getWins, eventUrl, isHappeningNow } from '../lib/content';
import { dateParts, formatEventDate, isoDate } from '../lib/dates';
import { withBase } from '../lib/url';

const [home, site, join, { upcoming, all }, wins, { advisors, current }] = await Promise.all([
  getSettings('home'),
  getSettings('site'),
  getSettings('join'),
  getEventTimeline(),
  getWins(),
  getCommittees(),
]);
const next = upcoming.slice(0, 3);
const stats = [
  { value: site.founded.getFullYear(), label: 'founded, in the Department of CIS' },
  { value: all.length, label: 'events run or joined' },
  { value: wins.length, label: 'competition results' },
  { value: site.followers, label: 'people following on Facebook' },
];
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="kicker">DIU Computing &amp; Information System Club</p>
      <h1 id="hero-title">{home.heroTitle}</h1>
      <p class="lead">{home.heroLead}</p>
      <div class="cta">
        <a class="button" href={withBase('/join/')}>Join the club</a>
        <a class="button button--quiet" href={withBase('/events/')}>See events</a>
      </div>
    </div>
    <NeuralHero caption={home.networkCaption} />
  </section>

  {
    next.length > 0 && (
      <section class="section container" aria-labelledby="next-title">
        <div class="heading-row">
          <h2 id="next-title">Coming up</h2>
          <a href={withBase('/events/')}>All events</a>
        </div>
        <ol class="upcoming">
          {next.map((e) => {
            const d = dateParts(e.data);
            const live = isHappeningNow(e);
            return (
              <li class:list={['up', { 'is-live': live }]}>
                <time class="up-date tabular" datetime={isoDate(e.data.date)}>
                  <span class="up-day">{d.day}</span>
                  <span class="up-month">
                    {d.month} {d.year}
                  </span>
                </time>
                <div class="up-body">
                  {live && (
                    <p class="live">
                      <span class="live-dot" /> Happening now
                    </p>
                  )}
                  <h3>
                    <a href={withBase(eventUrl(e))}>{e.data.title}</a>
                  </h3>
                  <p class="muted">{[formatEventDate(e.data), e.data.venue].filter(Boolean).join(', ')}</p>
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    )
  }

  <section class="section wins-section" aria-labelledby="wins-title">
    <div class="container">
      <div class="heading-row">
        <h2 id="wins-title">Recent wins</h2>
        <a href={withBase('/events/?category=competitions-wins')}>Every result</a>
      </div>
      <ol class="wins">
        {
          wins.slice(0, 6).map((e) => (
            <li>
              <a href={withBase(eventUrl(e))}>
                <span class="win-result">{e.data.result}</span>
                <span class="win-event">{e.data.title}</span>
                <time class="win-date tabular" datetime={isoDate(e.data.date)}>
                  {formatEventDate({ date: e.data.date, approximate: true })}
                </time>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section container about" aria-labelledby="about-title">
    <div>
      <h2 id="about-title">A club for people who build</h2>
      <p class="about-text">{home.aboutBlurb}</p>
      <a class="more" href={withBase('/about/')}>Our story and committee</a>
    </div>
    <dl class="stats">
      {
        stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd class="tabular">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section container people" aria-labelledby="people-title">
    <div class="heading-row">
      <h2 id="people-title">The people behind it</h2>
      <a href={withBase('/about/#committee')}>Full committee</a>
    </div>
    <div class="people-grid">
      {
        advisors && (
          <div>
            <h3 class="group-title">Advisors</h3>
            <ul class="person-list">
              {advisors.data.members.map((m) => (
                <PersonCard {...m} />
              ))}
            </ul>
          </div>
        )
      }
      {
        current && (
          <div>
            <h3 class="group-title">{current.data.name}</h3>
            <ul class="person-list person-list--two">
              {current.data.members.slice(0, 8).map((m) => (
                <PersonCard {...m} />
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <section class="container" aria-labelledby="join-title">
    <div class="join chamfer">
      <div>
        <h2 id="join-title">{home.joinTitle}</h2>
        <p>{home.joinText}</p>
      </div>
      <div class="join-side">
        <ul>{join.benefits.slice(0, 3).map((b) => <li>{b}</li>)}</ul>
        <a class="button join-button" href={withBase('/join/')}>Become a member</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-8);
    align-items: center;
    padding-block: var(--space-7) var(--space-8);
  }
  .kicker {
    font-weight: 500;
    color: var(--ink-soft);
    margin-bottom: var(--space-4);
  }
  h1 {
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    font-weight: 800;
    font-stretch: 82%;
    letter-spacing: -0.03em;
  }
  .hero .lead {
    margin-top: var(--space-5);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .heading-row a {
    font-weight: 500;
  }

  /* Coming up: big typographic dates on a rule. */
  .upcoming {
    list-style: none;
    padding: 0;
    border-top: 1.5px solid var(--ink);
  }
  .up {
    position: relative;
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--rule);
  }
  .up-date {
    display: grid;
    line-height: 1;
  }
  .up-day {
    font-size: var(--text-3xl);
    font-weight: 800;
    font-stretch: 82%;
  }
  .up-month {
    margin-top: var(--space-1);
    color: var(--ink-soft);
  }
  .is-live .up-day {
    color: var(--signal);
  }
  .up-body h3 {
    font-size: var(--text-xl);
  }
  .up-body a {
    text-decoration: none;
  }
  .up-body a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .up:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: from-font;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--signal-strong);
  }

  /* Recent wins: a dense typographic ledger on sunk paper. */
  .wins-section {
    background: var(--paper-sunk);
  }
  .wins {
    list-style: none;
    padding: 0;
    columns: 2 22rem;
    column-gap: var(--space-7);
  }
  .wins li {
    break-inside: avoid;
    border-top: 1px solid var(--rule);
  }
  .wins a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-4);
    text-decoration: none;
  }
  .win-result {
    grid-column: 1 / -1;
    font-size: var(--text-xl);
    font-weight: 750;
    font-stretch: 88%;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .wins a:hover .win-result {
    color: var(--signal-strong);
  }
  .win-event {
    color: var(--ink-soft);
  }
  .win-date {
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  .about {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }
  .about-text {
    margin-top: var(--space-4);
    max-width: 60ch;
    font-size: var(--text-lg);
    line-height: 1.6;
  }
  .more {
    display: inline-block;
    margin-top: var(--space-4);
    font-weight: 600;
  }
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6) var(--space-5);
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
    padding-top: var(--space-3);
    border-top: 1.5px solid var(--ink);
  }
  .stats dd {
    font-size: var(--text-3xl);
    font-weight: 800;
    font-stretch: 82%;
    line-height: 1;
  }
  .stats dt {
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  .people-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-7);
  }
  .group-title {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--ink-soft);
    margin-bottom: var(--space-4);
  }
  .person-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .person-list--two {
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }

  .join {
    --cut: var(--cut-lg);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-7);
    padding: clamp(2rem, 5vw, 4rem);
    background: var(--ink);
    color: var(--on-ink);
  }
  .join h2 {
    font-size: var(--text-3xl);
    font-weight: 800;
    font-stretch: 85%;
    line-height: 1.05;
  }
  .join p {
    margin-top: var(--space-4);
    max-width: 46ch;
    color: color-mix(in srgb, var(--on-ink) 80%, transparent);
    font-size: var(--text-lg);
  }
  .join-side ul {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.1em;
    margin-bottom: var(--space-6);
  }
  .join-side li::marker {
    color: var(--signal);
  }
  .join-button {
    background: var(--signal);
  }
  .join-button:hover {
    background: var(--on-ink);
    color: var(--ink);
  }

  @media (max-width: 60rem) {
    .hero,
    .about,
    .people-grid,
    .join {
      grid-template-columns: 1fr;
    }
    .hero {
      gap: var(--space-7);
      padding-top: var(--space-6);
    }
  }
  @media (max-width: 34rem) {
    .up {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .up-date {
      display: flex;
      align-items: baseline;
      gap: var(--space-2);
    }
    .up-day {
      font-size: var(--text-2xl);
    }
  }
</style>
