# Copy to .env for local development. In GitHub, set these as repository
# *variables* (Settings → Secrets and variables → Actions → Variables).
# Both values are public by design: security comes from Row Level Security
# and end-to-end encryption, not from hiding these.

# Supabase → Project Settings → API
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The *publishable* key (sb_publishable_…). Never use the secret/service_role key.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Set by the deploy workflow; only needed locally to test a sub-path build.
# SITE_URL=https://<user>.github.io
# BASE_PATH=/<repo>
